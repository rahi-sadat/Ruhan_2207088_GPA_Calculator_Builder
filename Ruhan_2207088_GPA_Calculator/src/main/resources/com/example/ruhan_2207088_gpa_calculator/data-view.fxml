<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="550.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ruhan_2207088_gpa_calculator.DataController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label text="Student Records Management">
                <font>
                    <Font size="20.0" />
                </font>
            </Label>

            <TableView fx:id="studentTable" prefHeight="400.0" prefWidth="860.0">
                <columns>
                    <TableColumn fx:id="rollColumn" prefWidth="120.0" text="Roll" />
                    <TableColumn fx:id="nameColumn" prefWidth="300.0" text="Student Name" />
                    <TableColumn fx:id="gpaColumn" prefWidth="120.0" text="CGPA" />
                    <TableColumn fx:id="creditColumn" prefWidth="120.0" text="Total Credit" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER" spacing="20.0">
                <Button text="Edit GPA" onAction="#editRecord" />
                <Button text="Delete Record" onAction="#deleteRecord" style="-fx-background-color: #d32f2f; -fx-text-fill: white;" />
            </HBox>

            <Button text="Back to Result View" onAction="#backToResultView" />

        </VBox>
    </children>
</AnchorPane>
